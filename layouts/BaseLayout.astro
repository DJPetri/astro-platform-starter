---
const { title = "Petrievents" } = Astro.props;
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- 🔗 Open Graph Meta Tags für Social Media Vorschau -->
    <meta property="og:title" content="Petrievents" />
    <meta property="og:description" content="DJ & Eventtechnik. Jetzt anfragen!" />
    <meta property="og:image" content="https://petrievents.de/social-preview.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://petrievents.de" />
    <meta property="og:type" content="website" />
    <link rel="image_src" href="https://petrievents.de/social-preview.jpg" />

    <!-- Für Twitter (optional) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Petrievents" />
    <meta name="twitter:description" content="DJ & Eventtechnik. Jetzt anfragen!" />
    <meta name="twitter:image" content="https://petrievents.de/social-preview.jpg" />
  </head>

  <body>
    <button class="sidebar-toggle" aria-label="Menü ein-/ausblenden">
      <img src="/favicon.svg" alt="Menü" />
    </button>

    <div class="layout">
      <aside class="sidebar">
        <nav class="sidebar-nav">
          <a href="/">Startseite</a>
          <a href="/galerie">Galerie</a>
          <a href="/kontakt">Kontakt</a>
          <a href="/partner">Partner</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutzerklärung</a>
          <!--<a href="/PetriEvents_mietkatalog.pdf" target="_blank">Mietkatalog 💾</a>-->
          <a href="/instagram" class="with-icon" aria-label="Instagram Seite">
            <svg width="18" height="18" viewBox="0 0 448 512" aria-hidden="true" style="vertical-align:-2px; margin-right:.5rem;">
              <title>Instagram Icon</title>
              <path fill="currentColor" d="M224 202.66A53.34 53.34 0 1 0 277.34 256 53.38 53.38 0 0 0 224 202.66zm124.71-41a54 54 0 0 0-30.53-30.53C296.69 121 224 121 224 121s-72.69 0-94.18 10.1a54 54 0 0 0-30.53 30.53C89.19 163.49 89.19 224 89.19 224s0 60.51 10.1 82a54 54 0 0 0 30.53 30.53C161.31 346.93 224 346.93 224 346.93s72.69 0 94.18-10.1a54 54 0 0 0 30.53-30.53c10.1-21.49 10.1-82 10.1-82s0-60.51-10.1-82zM224 318.6A94.6 94.6 0 1 1 318.6 224 94.61 94.61 0 0 1 224 318.6zm98.34-170.5a22.11 22.11 0 1 1 22.11-22.11 22.11 22.11 0 0 1-22.11 22.11zM448 80v352a80 80 0 0 1-80 80H80A80 80 0 0 1 0 432V80A80 80 0 0 1 80 0h288a80 80 0 0 1 80 80zm-64 0a16 16 0 0 0-16-16H80a16 16 0 0 0-16 16v352a16 16 0 0 0 16 16h288a16 16 0 0 0 16-16z"/>
            </svg>
            Instagram
          </a>
        </nav>

        <div class="sidebar-bottom">
          <img src="/mein-bild.png" alt="Petrievents Logo" />
        </div>
      </aside>


      <main class="main-content">
        <slot />
      </main>
    </div>

    <script>
      const toggle = document.querySelector('.sidebar-toggle');
      const sidebar = document.querySelector('.sidebar');
      if (toggle && sidebar) {
        toggle.addEventListener('click', () => {
          sidebar.classList.toggle('collapsed');
        });
      }
    </script>
    <!-- 🟢 Dein zusätzliches Sidebar-Skript -->
    <script type="module" src="/scripts/adjustSidebar.js"></script>
    <script type="module" src="/scripts/hideSidebarOnScroll.js"></script>
  </body>
</html>