---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Galerie | Petrievents">
  <section class="features">
    <h2>Galerie</h2>
    <div class="grid">
      {Array.from({ length: 12 }).map((_, i) => (
        <img
         src={`/bilder/bild${i + 1}.jpg`} 
         alt={`Eventbild ${i + 1}`} 
         loading="lazy"
         class="gallery-image"
         tabindex="0"
         role="button"
         aria-label={`Eventbild ${i + 1} in Großansicht öffnen`}
         />
      ))}
    </div>
    <!-- Lightbox Overlay -->
  </section>
  <div id="lightbox" class="lightbox hidden" role="dialog" aria-modal="true" aria-label="Eventbild in Großansicht">
    <span class="lightbox-close" role="button" tabindex="0" aria-label="Großansicht schließen">&times;</span>
     <span class="lightbox-arrow left" role="button" tabindex="0" aria-label="Vorheriges Bild">&#10094;</span> <!-- ‹ -->
    <img class="lightbox-img" src="" alt="Großansicht" />
    <span class="lightbox-arrow right" role="button" tabindex="0" aria-label="Nächstes Bild">&#10095;</span>
  </div>

<!-- 🟢 Dein zusätzliches Sidebar-Skript -->
  <script type="module" src="/scripts/lightbox.js"></script>

</BaseLayout>