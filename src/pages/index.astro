---
// index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>
  <script is:inline>
    const mobileEntry = window.matchMedia("(max-width: 900px)");

    if (mobileEntry.matches && (!location.hash || location.hash === "#willkommen")) {
      const previousRestoration = history.scrollRestoration;
      history.scrollRestoration = "manual";

      if (location.hash === "#willkommen") {
        history.replaceState(history.state, "", location.pathname + location.search);
      }

      let interacted = false;
      const showPhoto = () => {
        if (mobileEntry.matches && !interacted) {
          history.scrollRestoration = "manual";
          window.scrollTo({ top: 0, behavior: "instant" });
        }
      };

      ["pointerdown", "touchstart", "wheel", "keydown", "click"].forEach((type) => {
        window.addEventListener(type, () => { interacted = true; }, { once: true, passive: true });
      });
      mobileEntry.addEventListener("change", () => {
        history.scrollRestoration = mobileEntry.matches ? "manual" : previousRestoration;
      });
      window.addEventListener("pagehide", () => {
        history.scrollRestoration = previousRestoration;
      });
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) interacted = false;
        showPhoto();
      });
      window.addEventListener("load", showPhoto, { once: true });
      showPhoto();
    }
  </script>

<section class="heading home-heading">
  <div class="card-imageheading">
    <img src="/bilder/logo.png" alt="DJ Denny Dusk" />
  </div>

  <div class="card-contentheading">
    <div class="artist-name">
      <div class="dj-label">DJ</div>

      <div class="name-line"></div>

      <div class="main-name">
        <span class="denny">Denny</span>
        <span class="dusk">Dusk</span>
      </div>
    </div>
  </div>
</section>

  <section class="home-welcome" aria-labelledby="mobile-welcome-title">
    <div class="home-welcome-content">
      <p class="home-welcome-eyebrow">Willkommen bei DJ Denny Dusk</p>
      <h1 id="mobile-welcome-title">
        Ihre Feier.<br />
        <span>Ihr Moment.</span>
      </h1>
      <p class="home-welcome-description">
        Musik. Licht. Unvergessliche Nächte.
      </p>
      <a href="/kontakt" class="home-welcome-contact">Termin anfragen</a>
    </div>
    <a href="#willkommen" class="home-welcome-discover">
      <span>Mehr entdecken</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 4v16m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section id="willkommen" class="intro card offset-left home-reveal">
    <div class="card-content">
      <div class="card-text">
        <h2><span class="highlight">Willkommen</span>!</h2>
        <p>
          Sie suchen einen DJ, der nicht nur Musik abspielt, sondern Ihre Feier
          wirklich zum Leben erweckt?
        </p>
        <p>
          Als professioneller mobiler DJ begleite ich Hochzeiten, Firmenfeiern
          und private Events mit dem richtigen Gespür für Stimmung, Timing und
          Publikum. Jede Veranstaltung ist einzigartig und genau so behandle
          ich sie auch.
        </p>
        <div class="mobile-text-flow">
        <div class="card-image mobile-card-image">
          <img src="/bilder/ambiente.jpg" alt="Atmosphäre und Ambiente für eine Feier" width="1024" height="1024" loading="lazy" decoding="async" />
        </div>
        <p>
          Mit hochwertiger eigener Ton- und Lichttechnik, stilvollem Aufbau und
          einem Musikmix, der Generationen verbindet, entsteht eine Atmosphäre,
          die Ihre Gäste nicht vergessen werden.
        </p>
        <p>Lehnen Sie sich zurück, ich sorge für eine volle Tanzfläche.</p>
        </div>
      </div>
      <div class="card-image">
        <img src="/bilder/bild7.jpg" alt="Intro Bild" />
      </div>
    </div>
  </section>

  <section class="features card offset-right home-reveal">
    <div class="card-content">
      <div class="card-text">
        <h2>Warum Sie sich auf mich verlassen können</h2>
        <p>
          Eine Hochzeit oder ein besonderes Event lebt von der richtigen
          Atmosphäre und die entsteht nicht zufällig.
        </p>

        <ul>
          <li>
            <strong>Erfahrung mit Hochzeiten:</strong> Ich kenne Abläufe, Emotionen
            und die Dynamik eines solchen Abends.
          </li>
          <li>
            <strong>Musik für alle Generationen:</strong> Bei mir findet sich jeder
            auf der Tanzfläche wieder.
          </li>
          <li>
            <strong>Stilvoller Aufbau:</strong> Keine Banner, kein Kabelchaos nur
            ein elegantes DJ-Setup.
          </li>
          <li>
            <strong>Persönliches Vorgespräch:</strong> Ihre Wünsche stehen im Mittelpunkt.
          </li>
        </ul>
      </div>
      <div class="card-image">
        <picture>
          <source media="(max-width: 900px)" srcset="/bilder/bild6.jpg" />
          <img src="/bilder/20260225_CasinoPartyorange.jpg" alt="Intro Bild" />
        </picture>
      </div>
    </div>
  </section>

  <section class="mission card offset-left home-reveal">
    <div class="card-content">
      <div class="card-text">
        <h2>So entsteht eine perfekte Feier</h2>

      <p>
        Ein gelungenes Event beginnt nicht am Abend der Feier,
        sondern lange vorher.
      </p>

      <p>
        In einem persönlichen Vorgespräch besprechen wir
        Ihre Wünsche, Ihren Musikgeschmack
        und den geplanten Ablauf.
        So entsteht ein klarer Rahmen,
        der mir ermöglicht,
        flexibel und situationsgerecht zu reagieren.
      </p>

      <div class="mobile-text-flow">
      <div class="card-image mobile-card-image">
        <img src="/bilder/beratung_hochzeitsdj.jpg" alt="Persönliches Vorgespräch zur Planung einer Hochzeit" width="1536" height="1024" loading="lazy" decoding="async" />
      </div>

      <p>
        Während Ihrer Veranstaltung lese ich das Publikum,
        steuere die Energie des Abends
        und sorge dafür,
        dass sich jede Generation auf der Tanzfläche wiederfindet.
      </p>

      <p>
        Sie feiern
        ich kümmere mich um den Rest.
      </p>
      </div>
      </div>
      <div class="card-image">
        <img src="/bilder/bodennebel2.png" alt="Intro Bild" />
      </div>
    </div>
  </section>

  <section class="card offset-right home-reveal home-cta">
  <div class="card-content">

    <div class="card-text">
      <h2>
        Lassen Sie uns Ihr Event unvergesslich machen
      </h2>

      <p>
        Ob Hochzeit, Firmenfeier oder privates Event:
        Wenn Musik, Stimmung und Technik perfekt zusammenspielen,
        entsteht eine Atmosphäre,
        die Gäste noch lange in Erinnerung behalten.
      </p>

      <p>
        Genau dafür sorge ich.
        Mit Erfahrung, Feingefühl und dem Anspruch,
        jede Feier einzigartig zu machen.
      </p>

      <p>
        <strong>
          Jetzt unverbindlich Ihren Termin anfragen und sichern.
        </strong>
      </p>

      <a href="/kontakt" class="btn-primary">
        Termin anfragen
      </a>
    </div>

  </div>
</section>

  <script>
    const welcome = document.querySelector<HTMLElement>(".home-welcome");
    const introduction = document.querySelector<HTMLElement>("#willkommen");
    const discover = welcome?.querySelector<HTMLAnchorElement>(".home-welcome-discover");

    if (welcome && introduction && discover) {
      const glideMedia = window.matchMedia(
        "(max-width: 900px) and (prefers-reduced-motion: no-preference)"
      );
      const scrollFactor = 1.5;
      let distance = 1;
      let frame = 0;

      const reset = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        welcome.removeAttribute("data-scroll-glide");
        welcome.style.removeProperty("--welcome-collapse");
        welcome.style.removeProperty("--welcome-scale");
        welcome.style.removeProperty("--welcome-opacity");
        welcome.inert = false;
      };

      const render = () => {
        frame = 0;
        if (!glideMedia.matches) return;

        const progress = Math.min(1, Math.max(0, window.scrollY / (distance / scrollFactor)));
        const collapse = distance * (1 - 1 / scrollFactor) * progress;
        welcome.style.setProperty("--welcome-collapse", `${collapse}px`);
        welcome.style.setProperty("--welcome-scale", String(1 - 0.18 * progress));
        welcome.style.setProperty("--welcome-opacity", String(1 - progress * progress));
        welcome.inert = progress === 1;
      };

      const measure = () => {
        document.documentElement.toggleAttribute("data-home-glide", glideMedia.matches);
        reset();
        if (!glideMedia.matches) return;

        const top = welcome.getBoundingClientRect().top + window.scrollY;
        const gap = parseFloat(getComputedStyle(welcome).marginBottom);
        const targetOffset = parseFloat(getComputedStyle(introduction).scrollMarginTop);
        distance = Math.max(1, top + welcome.offsetHeight + gap - targetOffset);
        welcome.setAttribute("data-scroll-glide", "");
        render();
      };

      window.addEventListener("scroll", () => {
        if (glideMedia.matches && !frame) frame = requestAnimationFrame(render);
      }, { passive: true });
      window.addEventListener("resize", measure);
      glideMedia.addEventListener("change", measure);
      new ResizeObserver(measure).observe(welcome);
      document.fonts.ready.then(measure);

      discover.addEventListener("click", (event) => {
        if (!glideMedia.matches || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        introduction.setAttribute("tabindex", "-1");
        introduction.focus({ preventScroll: true });
        window.scrollTo({ top: distance / scrollFactor, behavior: "smooth" });
      });

      measure();
    }
  </script>

  <style>
    /* === Versetzter Kartenstil (passend zum globalen CSS) === */
    /* =========================
   CARDS (Basis)
========================= */

    .card {
      background: rgba(17, 17, 29, 0.9);
      border-radius: 2rem;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.45);
      padding: 2rem;
      margin-bottom: 3rem;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    .card:hover {
      transform: scale(1.02) translateX(var(--card-offset, 0));
      box-shadow: 0 0 20px rgba(102, 204, 255, 0.3);
    }

    /* =========================
   OFFSET SYSTEM
========================= */

    .offset-left {
      --card-offset: -2%;
      transform: translateX(var(--card-offset));
    }

    .offset-right {
      --card-offset: 5%;
      transform: translateX(var(--card-offset));
    }

    @media (max-width: 900px) {
      .offset-left,
      .offset-right {
        transform: none;
      }

      .card:hover {
        transform: none;
      }
    }

    /* =========================
   CARD LAYOUT (Text + Bild)
========================= */

    .card-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .card-text {
      flex: 1 1 60%;
      line-height: 1.6;
    }

    .card-image {
      flex: 1 1 35%;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .card-image img {
      width: 100%;
      max-height: 300px;
      object-fit: cover;
      border-radius: 1rem;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
    }

    /* Links / Rechts Wechsel */
    .offset-right .card-content {
      flex-direction: row-reverse;
    }

    /* Mobile */
    @media (max-width: 900px) {
      .card-content {
        flex-direction: column !important;
      }

      .card-text,
      .card-image {
        flex: 1 1 100%;
        text-align: center;
      }

      .card-image img {
        max-height: 250px;
      }
    }

    /* =========================
   FEATURES LISTE
========================= */

    .features ul {
      list-style: none;
      padding-left: 0;
    }

    .features li {
      margin-bottom: 1rem;
      padding-left: 1.5rem;
      position: relative;
    }

    .features li::before {
      content: "✔️";
      position: absolute;
      left: 0;
    }

    /* =========================
   TEXTBEREICHE
========================= */

    .intro p,
    .mission p {
      margin-bottom: 1.5rem;
    }

    /* =========================
   COUNTER
========================= */

    .counter {
      text-align: center;
      color: #aaa;
      font-size: 0.9rem;
      margin-top: 2rem;
    }

    /* =========================
   HEADER (Logo + Name)
========================= */

    .heading {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0.5rem 0;
    }

    .card-imageheading {
      grid-column: 1;
      justify-self: start;
    }

    .card-contentheading {
      grid-column: 2;
      text-align: center;
      font-size: 2rem;
    }
    .card-contentheading .subheading {
      font-size: 2rem; /* DJ größer */
      font-weight: 700; /* kräftiger */
      margin-top: 0.2rem;
    }

    .card-imageheading img {
      width: 200px;
      border-radius: 0rem;
     
    }
    .name-first {
      color: #66ccff; /* Logo Blau */
    }

    .name-last {
      color: #eb8136; /* Logo Orange */
    }

    @media (max-width: 900px) {
      .heading.home-heading {
        display: none;
      }

      .heading {
        display: block;
        min-height: 0;
        padding: 1.15rem 1.25rem;
        margin-bottom: 1rem;
      }

      .card-contentheading {
        text-align: left;
        font-size: 1rem;
      }

      .card-contentheading .subheading {
        font-size: 0.78rem;
        letter-spacing: 0.28em;
        margin-top: 0.55rem;
      }

      .artist-name {
        font-size: clamp(1.85rem, 9vw, 2.45rem);
        line-height: 1;
        margin-bottom: 0;
      }

      .card-imageheading {
        display: none;
      }

      .name-first,
      .name-last {
        display: inline;
      }

      .name-first::after {
        content: " ";
        white-space: pre;
      }
    }

    @media (max-width: 480px) {
      .card {
        padding: 1rem;
        border-radius: 1rem;
        margin-bottom: 1rem;
      }

      .card-text,
      .card-image {
        text-align: left;
      }

      .card-image img {
        max-height: 220px;
      }
    }

    .card {
      background: linear-gradient(180deg, rgba(18, 22, 34, 0.94), rgba(12, 15, 23, 0.84));
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
      overflow: hidden;
    }

    .card:hover {
      box-shadow: 0 26px 80px rgba(102, 204, 255, 0.18);
    }

    .card-image img {
      aspect-ratio: 4 / 3;
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .card-text p {
      color: #b8c0cc;
    }

    .heading {
      min-height: 280px;
      background:
        linear-gradient(135deg, rgba(102, 204, 255, 0.16), transparent 42%),
        linear-gradient(315deg, rgba(235, 129, 54, 0.18), transparent 44%),
        rgba(15, 18, 28, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.12);
      overflow: hidden;
    }

    .artist-name {
      margin-bottom: 0.35rem;
      line-height: 0.95;
    }

    .name-first,
    .name-last {
      display: block;
    }

    .card-contentheading .subheading {
      color: #f5f7fb;
      letter-spacing: 0.35em;
      text-transform: uppercase;
    }

    .card-imageheading img {
      filter: drop-shadow(0 18px 35px rgba(0, 0, 0, 0.35));
    }

    .home-cta .card-content {
      max-width: 720px;
    }

    @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .home-heading {
          animation: home-heading-focus linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 38%;
        }

        .home-reveal {
          animation: home-card-arrival linear both;
          animation-timeline: view();
          animation-range: entry 5% cover 36%;
        }

        .home-reveal:nth-of-type(even) {
          animation-name: home-card-arrival-right;
        }

        .home-reveal .card-image img {
          animation: home-image-focus linear both;
          animation-timeline: view();
          animation-range: entry 5% cover 74%;
        }

        @keyframes home-heading-focus {
          from {
            opacity: 0.35;
            transform: scale(0.96);
          }
          to {
            opacity: 1;
            transform: scale(1);
          }
        }

        @keyframes home-card-arrival {
          from {
            opacity: 0.2;
            transform: translateX(-16px) scale(0.975);
          }
          to {
            opacity: 1;
            transform: translateX(0) scale(1);
          }
        }

        @keyframes home-card-arrival-right {
          from {
            opacity: 0.2;
            transform: translateX(16px) scale(0.975);
          }
          to {
            opacity: 1;
            transform: translateX(0) scale(1);
          }
        }

        @keyframes home-image-focus {
          from {
            transform: scale(0.93);
            filter: saturate(0.82) brightness(0.82);
          }
          to {
            transform: scale(1.03);
            filter: saturate(1.06) brightness(1.02);
          }
        }
      }
    }
  .artist-name {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;

    margin: 0;
    text-align: left;
  }

  .artist-name .dj-label {
    color: #F4C982;

    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;

    margin-bottom: 10px;
  }

  .artist-name .name-line {
    width: 330px;
    height: 1px;

    background: linear-gradient(
      90deg,
      #F4C982,
      rgba(244, 201, 130, 0.45),
      transparent
    );

    margin-bottom: 14px;
  }

  .artist-name .main-name {
    display: flex;
    align-items: baseline;
    gap: 18px;

    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: clamp(52px, 5vw, 76px);
    font-weight: 600;
    line-height: 1;

    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .artist-name .denny {
    color: #F4C982;
  }

  .artist-name .dusk {
    color: #f5f2ed;
  }

    .mobile-card-image {
      display: none;
    }

    div.mobile-text-flow {
      display: contents;
    }

    .card-image picture {
      display: contents;
    }

    .home-welcome {
      display: none;
    }

    @media (max-width: 900px) {
      .home-welcome {
        display: grid;
        grid-template-rows: 1fr auto;
        gap: 1.5rem;
        min-height: calc(100vh - 7.5rem);
        min-height: calc(100svh - 7.5rem);
        padding: clamp(1.25rem, 5vw, 2.5rem);
        margin-bottom: 1.25rem;
        overflow: hidden;
        background:
          linear-gradient(180deg, rgba(11, 8, 11, 0.05), rgba(11, 8, 11, 0.12) 40%, rgba(11, 8, 11, 0.78) 75%, rgba(11, 8, 11, 0.94)),
          url('/bilder/20260225_CasinoPartyorange.jpg') center / cover no-repeat;
        border: 1px solid rgba(255, 208, 138, 0.28);
        border-radius: 18px;
        transform: none;
      }

      .home-welcome-content {
        align-self: end;
        max-width: 32rem;
        padding-top: clamp(9rem, 26svh, 16rem);
      }

      .home-welcome-eyebrow {
        margin-bottom: clamp(2.25rem, 5svh, 3rem);
        color: var(--gold);
        font-size: clamp(1rem, 3.5vw, 1.25rem);
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .home-welcome h1 {
        margin-bottom: 1rem;
        color: var(--text);
        font-size: clamp(2.1rem, 8vw, 3.25rem);
        line-height: 1.04;
        letter-spacing: -0.025em;
      }

      .home-welcome h1 span {
        color: var(--gold);
      }

      .home-welcome-description {
        max-width: 28rem;
        margin-bottom: 0.5rem;
        color: var(--text);
        font-size: clamp(0.95rem, 2.5vw, 1.1rem);
        line-height: 1.6;
      }

      .home-welcome-contact {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--muted);
        font-size: 0.85rem;
        text-decoration: underline;
        text-underline-offset: 0.25em;
      }

      .home-welcome-contact:hover {
        color: var(--text);
      }

      .home-welcome-discover {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        min-height: 48px;
        padding: 0.5rem;
        color: var(--text);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-decoration: none;
      }

      .home-welcome-discover:hover {
        color: var(--gold);
      }

      .home-welcome a:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 4px;
      }

      .intro .card-content,
      .features .card-content,
      .mission .card-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: 1rem;
      }

      .intro .card-text,
      .features .card-text,
      .mission .card-text {
        display: contents;
        text-align: left;
      }

      .intro .card-text > *,
      .features .card-text > *,
      .mission .card-text > * {
        grid-column: 1 / -1;
        min-width: 0;
        margin-bottom: 0;
      }

      .intro .card-content {
        grid-template-columns: minmax(0, 1fr) clamp(5.5rem, 30vw, 10rem);
      }

      .intro .card-text > p:first-of-type {
        grid-column: 1;
        grid-row: 2;
      }

      .intro .card-image {
        grid-column: 2;
        grid-row: 2;
        align-self: stretch;
        align-items: stretch;
        min-width: 0;
      }

      .intro .card-image img {
        height: 100%;
        max-height: none;
        aspect-ratio: auto;
      }

      .features .card-image,
      .mission .card-image {
        grid-column: 1;
        grid-row: 3;
        min-width: 0;
      }

      .features .card-image img,
      .mission .card-image img {
        max-height: 260px;
        aspect-ratio: 16 / 10;
      }

      .mobile-card-image {
        display: flex;
      }

      .intro .mobile-text-flow,
      .mission .mobile-text-flow {
        display: flow-root;
      }

