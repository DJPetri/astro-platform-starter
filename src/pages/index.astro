---
// index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="heading">
    <div class="card-imageheading">
      <img src="/bilder/logo.png" alt="Intro Bild" />
    </div>
    <div class="card-contentheading">
      <h1 class="artist-name">
        <span class="name-first">Christian</span>
        <span class="name-last">Petri</span>
      </h1>
      <p class="subheading">DJ</p>
    </div>
  </section>

  <section class="intro card offset-left">
    <div class="card-content">
      <div class="card-text">
        <h2><span class="highlight">Wilkommen</span> !</h2>
        <p>
          Sie suchen einen DJ, der nicht nur Musik abspielt, sondern Ihre Feier
          wirklich zum Leben erweckt?
        </p>
        <p>
          Als professioneller mobiler DJ begleite ich Hochzeiten, Firmenfeiern
          und private Events mit dem richtigen Gespür für Stimmung, Timing und
          Publikum. Jede Veranstaltung ist einzigartig – und genau so behandle
          ich sie auch.
        </p>
        <p>
          Mit hochwertiger eigener Ton- und Lichttechnik, stilvollem Aufbau und
          einem Musikmix, der Generationen verbindet, entsteht eine Atmosphäre,
          die Ihre Gäste nicht vergessen werden.
        </p>
        <p>Lehnen Sie sich zurück – ich sorge für eine volle Tanzfläche.</p>
      </div>
      <div class="card-image">
        <img src="/bilder/bild7.jpg" alt="Intro Bild" />
      </div>
    </div>
  </section>

  <section class="features card offset-right">
    <div class="card-content">
      <div class="card-text">
        <h2>Warum Sie sich auf mich verlassen können</h2>
        <p>
          Eine Hochzeit oder ein besonderes Event lebt von der richtigen
          Atmosphäre – und die entsteht nicht zufällig.
        </p>

        <ul>
          <li>
            <strong>Erfahrung mit Hochzeiten:</strong> Ich kenne Abläufe, Emotionen
            und die Dynamik eines solchen Abends.
          </li>
          <li>
            <strong>Musik für alle Generationen:</strong> Bei mir findet sich jeder
            auf der Tanzfläche wieder.
          </li>
          <li>
            <strong>Stilvoller Aufbau:</strong> Keine Banner, kein Kabelchaos – nur
            ein elegantes DJ-Setup.
          </li>
          <li>
            <strong>Persönliches Vorgespräch:</strong> Ihre Wünsche stehen im Mittelpunkt.
          </li>
        </ul>
      </div>
      <div class="card-image">
        <img src="/bilder/20260225_CasinoPartyorange.jpg" alt="Intro Bild" />
      </div>
    </div>
  </section>

  <section class="mission card offset-left">
    <div class="card-content">
      <div class="card-text">
        <h2>So entsteht eine perfekte Feier</h2>

      <p>
        Ein gelungenes Event beginnt nicht am Abend der Feier,
        sondern lange vorher.
      </p>

      <p>
        In einem persönlichen Vorgespräch besprechen wir
        Ihre Wünsche, Ihren Musikgeschmack
        und den geplanten Ablauf.
        So entsteht ein klarer Rahmen,
        der mir ermöglicht,
        flexibel und situationsgerecht zu reagieren.
      </p>

      <p>
        Während Ihrer Veranstaltung lese ich das Publikum,
        steuere die Energie des Abends
        und sorge dafür,
        dass sich jede Generation auf der Tanzfläche wiederfindet.
      </p>

      <p>
        Sie feiern –
        ich kümmere mich um den Rest.
      </p>
      </div>
      <div class="card-image">
        <img src="/bilder/bodennebel2.png" alt="Intro Bild" />
      </div>
    </div>
  </section>

  <section class="card offset-right">
  <div class="card-content">

    <div class="card-text">
      <h2>
        Lassen Sie uns Ihr Event unvergesslich machen
      </h2>

      <p>
        Ob Hochzeit, Firmenfeier oder privates Event –
        wenn Musik, Stimmung und Technik perfekt zusammenspielen,
        entsteht eine Atmosphäre,
        die Gäste noch lange in Erinnerung behalten.
      </p>

      <p>
        Genau dafür sorge ich.
        Mit Erfahrung, Feingefühl und dem Anspruch,
        jede Feier einzigartig zu machen.
      </p>

      <p>
        <strong>
          Fragen Sie jetzt unverbindlich Ihren Termin an
          und sichern Sie sich Ihr Wunschdatum.
        </strong>
      </p>

      <a href="/kontakt" class="btn-primary">
        Termin anfragen
      </a>
    </div>

  </div>
</section>

  <p class="counter">
    Besucher Startseite: <span id="count-startseite">Lädt...</span>
  </p>

  <script>
    const counters = [{ key: "startseite", elementId: "count-startseite" }];

    counters.forEach((counter) => {
      fetch(`https://api.counterapi.dev/v1/petrievents/${counter.key}/up`)
        .then((response) => response.json())
        .then((data) => {
          const el = document.getElementById(counter.elementId);
          if (el) el.textContent = data.count;
        })
        .catch((err) => {
          console.error(`Fehler beim Zähler für ${counter.key}:`, err);
          const el = document.getElementById(counter.elementId);
          if (el) el.textContent = "❌";
        });
    });
  </script>

  <style>
    /* === Versetzter Kartenstil (passend zum globalen CSS) === */
    /* =========================
   CARDS (Basis)
========================= */

    .card {
      background: rgba(17, 17, 29, 0.9);
      border-radius: 2rem;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.45);
      padding: 2rem;
      margin-bottom: 3rem;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    .card:hover {
      transform: scale(1.02) translateX(var(--card-offset, 0));
      box-shadow: 0 0 20px rgba(102, 204, 255, 0.3);
    }

    /* =========================
   OFFSET SYSTEM
========================= */

    .offset-left {
      --card-offset: -2%;
      transform: translateX(var(--card-offset));
    }

    .offset-right {
      --card-offset: 5%;
      transform: translateX(var(--card-offset));
    }

    @media (max-width: 900px) {
      .offset-left,
      .offset-right {
        transform: none;
      }
    }

    /* =========================
   CARD LAYOUT (Text + Bild)
========================= */

    .card-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .card-text {
      flex: 1 1 60%;
      line-height: 1.6;
    }

    .card-image {
      flex: 1 1 35%;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .card-image img {
      width: 100%;
      max-height: 300px;
      object-fit: cover;
      border-radius: 1rem;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
    }

    /* Links / Rechts Wechsel */
    .offset-right .card-content {
      flex-direction: row-reverse;
    }

    /* Mobile */
    @media (max-width: 900px) {
      .card-content {
        flex-direction: column !important;
      }

      .card-text,
      .card-image {
        flex: 1 1 100%;
        text-align: center;
      }

      .card-image img {
        max-height: 250px;
      }
    }

    /* =========================
   FEATURES LISTE
========================= */

    .features ul {
      list-style: none;
      padding-left: 0;
    }

    .features li {
      margin-bottom: 1rem;
      padding-left: 1.5rem;
      position: relative;
    }

    .features li::before {
      content: "✔️";
      position: absolute;
      left: 0;
    }

    /* =========================
   TEXTBEREICHE
========================= */

    .intro p,
    .mission p {
      margin-bottom: 1.5rem;
    }

    /* =========================
   COUNTER
========================= */

    .counter {
      text-align: center;
      color: #aaa;
      font-size: 0.9rem;
      margin-top: 2rem;
    }

    /* =========================
   HEADER (Logo + Name)
========================= */

    .heading {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0.5rem 0;
    }

    .card-imageheading {
      grid-column: 1;
      justify-self: start;
    }

    .card-contentheading {
      grid-column: 2;
      text-align: center;
      font-size: 2rem;
    }
    .card-contentheading .subheading {
      font-size: 2rem; /* DJ größer */
      font-weight: 700; /* kräftiger */
      margin-top: 0.2rem;
    }

    .card-imageheading img {
      width: 200px;
      border-radius: 0rem;
     
    }
    .name-first {
      color: #66ccff; /* Logo Blau */
    }

    .name-last {
      color: #eb8136; /* Logo Orange */
    }
  </style>
</BaseLayout>
