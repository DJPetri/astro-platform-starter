---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Was kostet ein DJ? | Petrievents">

  <!-- ================= Intro ================= -->
  <section class="heading">
    <h1>Was kostet ein DJ?</h1>
    <p class="subheading">
      Ihr wollt, dass eure Veranstaltung richtig gefeiert wird? Mit Emotionen, Stimmung und Musik, die euch und eure Gäste mitreißt?
      Genau das macht ein erfahrener DJ! Er liest die Menge, sorgt für perfekte Übergänge und eine Tanzfläche, die bis zum Schluss voll bleibt.
      Aber wie entstehen eigentlich die Kosten für einen Profi-DJ?
    </p>
  </section>


  <!-- ================= Preise ================= -->
  <section class="preise-section">
    <h2>Eure DJ Kosten</h2>

    <div class="preise-grid">
      <div class="preise-card">
        <h3>Mein Preis für eure Veranstaltung</h3>
        <p>Mein kleinstes Paket startet bei <strong>1.499 €</strong> für eine Dauer von 6 Stunden.</p>
        <ul>
          <li>Hochwertige Ton- und Lichttechnik</li>
          <li>Auf- & Abbau der gesamten Technik</li>
          <li>Individuelle Anpassung nach euren Wünschen</li>
        </ul>
      </div>

      <div class="preise-card highlight">
        <h3>Preisrahmen & Orientierung</h3>
        <ul>
          <li><strong>Anfänger:</strong> 500 € – 1.000 €</li>
          <li><strong>Fortgeschrittener DJ:</strong> 1.000 € – 1.500 €</li>
          <li><strong>Profi-DJ im Nebenberuf:</strong> 1.500 € – 1.900 €</li>
          <li><strong>Hauptberuflicher Profi-DJ:</strong> 1.900 € – 2.500 €</li>
        </ul>
      </div>
    </div>


    <!-- ================= Beratung Block ================= -->
    <div class="beratung-block">
      <div class="beratung-image">
        <img src="/bilder/beratung_hochzeitsdj.jpg" alt="DJ berät Brautpaar über Musik und Lichttechnik" />
      </div>

      <div class="beratung-text">
        <h3>Warum Petrievents?</h3>
        <p>Bei mir bekommt ihr nicht nur einen DJ, sondern ein Rundum-sorglos-Paket:</p>
        <ul>
          <li><strong>🌍 Deutschland- & europaweite Buchung:</strong> Ich bin für euch da.</li>
          <li><strong>🤝 Persönlicher Kontakt:</strong> Vom ersten Gespräch bis zur Party.</li>
          <li><strong>💡 Individuelle Lösungen:</strong> Jede Hochzeit ist einzigartig.</li>
        </ul>
        <a href="/kontakt" class="button">Jetzt unverbindlich anfragen</a>
      </div>
    </div>
  </section>


  <!-- ================= Faktoren ================= -->
  <section class="features fakten">
    <h2>Welche Faktoren beeinflussen die Kosten?</h2>

    <div class="faktoren-grid">
      <div class="faktor"><div class="icon">🎧</div><h3>Erfahrung</h3><p>Erfahrung sorgt für Sicherheit und perfekte Stimmung.</p></div>
      <div class="faktor"><div class="icon">📍</div><h3>Region</h3><p>Ballungsräume sind meist teurer.</p></div>
      <div class="faktor"><div class="icon">⏱️</div><h3>Dauer</h3><p>Längere Events bedeuten höheren Aufwand.</p></div>
      <div class="faktor"><div class="icon">💡</div><h3>Technik</h3><p>Mehr Licht & Sound = mehr Kosten.</p></div>
    </div>
  </section>


  <!-- ================= CSS ================= -->
  <style>

    /* ================= Preise ================= */

    .preise-section {
      margin-top: 3rem;
      padding: 3rem;
      background: linear-gradient(180deg, rgba(18, 22, 34, 0.94), rgba(12, 15, 23, 0.84));
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;
      box-shadow: 0 24px 70px rgba(0,0,0,0.38);
    }

    .preise-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .preise-card {
      background: rgba(255,255,255,0.075);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 2rem;
      border-radius: 18px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .preise-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 20px rgba(102,204,255,0.4);
    }

    .preise-card.highlight {
      border: 1px solid #66ccff;
      background: linear-gradient(180deg, rgba(102,204,255,0.16), rgba(255,255,255,0.08));
    }


    /* ================= Beratung Block ================= */

    .beratung-block {
      display: flex;
      align-items: stretch; /* gleiche Höhe */
      gap: 3rem;
      margin-top: 3rem;
      flex-wrap: wrap;
    }

    .beratung-image {
      flex: 1;
      min-width: 280px;
    }

    .beratung-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 18px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .beratung-text {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .beratung-text h3 {
      color: #66ccff;
      margin-bottom: 1rem;
    }

    .beratung-text ul {
      list-style: none;
      padding: 0;
      margin-top: 1rem;
    }

    .beratung-text li {
      margin-bottom: 0.75rem;
    }

    .button {
      display: inline-block;
      margin-top: 1.5rem;
      background: #66ccff;
      color: #000;
      font-weight: bold;
      padding: 0.8rem 1.5rem;
      border-radius: 1rem;
      text-decoration: none;
      transition: background 0.3s;
    }

    .button:hover {
      background: #33bbee;
    }


    /* ================= Faktoren ================= */

    .features.fakten {
      margin-top: 4rem;
      padding: 3rem;
      background: linear-gradient(180deg, rgba(18, 22, 34, 0.94), rgba(12, 15, 23, 0.84));
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;
      box-shadow: 0 24px 70px rgba(0,0,0,0.38);
    }

    .faktoren-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .faktor {
      background: rgba(255,255,255,0.075);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 18px;
      padding: 1.5rem;
      text-align: center;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .faktor:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 20px rgba(102,204,255,0.4);
    }

    .icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    /* ================= Responsive ================= */

    @media (max-width: 900px) {
      .preise-section,
      .features.fakten {
        padding: 1.25rem;
        border-radius: 1rem;
      }

      .preise-grid,
      .faktoren-grid {
        grid-template-columns: 1fr;
      }

      .preise-card,
      .faktor {
        border-radius: 1rem;
      }

      .preise-card:hover,
      .faktor:hover {
        transform: none;
      }

      .beratung-block {
        flex-direction: column;
        gap: 1.25rem;
      }

      .beratung-image {
        min-width: 0;
      }

      .beratung-image img {
        height: auto;
      }
    }

    @media (max-width: 480px) {
      .preise-section,
      .features.fakten {
        padding: 1rem;
      }

      .preise-card,
      .faktor {
        padding: 1rem;
      }
    }

  </style>

</BaseLayout>
