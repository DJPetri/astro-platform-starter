---
import BaseLayout from "../../layouts/BaseLayout.astro";

const IG_USER = "DJDennyDusk"; 
const IG_URL = `https://www.instagram.com/${IG_USER}/`;
---

<BaseLayout title="Instagram | DJ Denny Dusk">
<section class="hero">
<h1>Folgen Sie DJ Denny Dusk auf <span class="highlight">Instagram</span></h1>
<p class="subheading">Aktuelle Bilder & Reels von Events ansehen.</p>


<!-- Primärer Profil-Link -->
<p style="margin-top:1rem">
<a class="btn" href={IG_URL} target="_blank" rel="noopener noreferrer">@{IG_USER} auf Instagram öffnen</a>
</p>
</section>


<style>
.btn { display:inline-block; padding:.6rem 1rem; border-radius:.6rem; background:#66ccff; color:#00121a; text-decoration:none; font-weight:600; }
.btn:hover { filter:brightness(.95); }


.ig-consent { background:#11111de0; border-radius:1rem; padding:1rem; box-shadow:0 0 10px rgba(0,0,0,.4); }
.ig-box { display:flex; gap:1rem; align-items:center; justify-content:space-between; flex-wrap:wrap; }
.ig-embed { margin-top:1rem; }
.ig-badge { display:inline-block; padding:1rem 1.25rem; border:2px solid #444; border-radius:1rem; font-weight:700; text-decoration:none; }
</style>
</BaseLayout>