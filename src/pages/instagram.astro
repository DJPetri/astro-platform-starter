---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Instagram">
  <section class="hero">
    <h1>Folge uns auf <span class="highlight">Instagram</span></h1>
    <p class="subheading">
      Bleibe auf dem Laufenden und entdecke unsere neuesten Events und Impressionen!
    </p>
    <a href="https://https://www.instagram.com/petrievents/" target="_blank" rel="noopener" style="display:inline-block;margin-top:2rem;">
      <img src="/instagram-icon.svg" alt="Instagram" style="width:64px;height:64px;" />
      <br />
      @petrievents
    </a>
  </section>
</BaseLayout>
