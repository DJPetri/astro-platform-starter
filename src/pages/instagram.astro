---
import BaseLayout from "../../layouts/BaseLayout.astro";


// ✅ HIER DEIN INSTAGRAM-NAME (ohne @)
const IG_USER = "petrievents"; // <- anpassen, z.B. "petrievents"
const IG_URL = `https://www.instagram.com/${IG_USER}/`;


// 🔒 DSGVO-Hinweis: Externe Einbettungen (Instagram/Meta) laden erst nach aktivem Klick.
---

<BaseLayout title="Instagram | Petrievents">
<section class="hero">
<h1>Folge mir auf <span class="highlight">Instagram</span></h1>
<p class="subheading">Aktuelle Bilder & Reels von Events – ganz ohne Login ansehen.</p>


<!-- Primärer Profil-Link -->
<p style="margin-top:1rem">
<a class="btn" href={IG_URL} target="_blank" rel="noopener noreferrer">@{IG_USER} auf Instagram öffnen</a>
</p>
</section>


<section class="features" style="margin-top:2rem">
<h2>Vorschau (Datenschutzfreundlich)</h2>
<p>
Um deine Privatsphäre zu schützen, wird die Instagram-Vorschau erst nach deinem Klick geladen. Dabei können Daten an
Instagram/Meta übermittelt werden.
</p>


<!-- Platzhalter-Container -->
<div id="ig-consent" class="ig-consent">
<div class="ig-box">
<p><strong>Instagram-Inhalte laden?</strong><br/>Durch das Laden akzeptierst du die Datenschutzbedingungen von Instagram/Meta.</p>
<button id="ig-load" class="btn">Vorschau laden</button>
</div>
</div>


<!-- Container für das Widget/Embed -->
<div id="ig-embed" class="ig-embed" hidden></div>
</section>


<script>
  // IG_URL aus Astro-Template ins Skript bringen
  const IG_URL = "{IG_URL}";
  const WIDGET_URL = ""; // optional: z.B. "https://lightwidget.com/widgets/DEIN_WIDGET.html"


const loadBtn = document.getElementById('ig-load');
const consent = document.getElementById('ig-consent');
const embed = document.getElementById('ig-embed');


function buildFallbackBadge(url) {
// Fallback: Zeige ein großes Profil-Badge, falls kein Widget hinterlegt ist
const a = document.createElement('a');
a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer';
a.className = 'ig-badge';
a.textContent = url.replace('https://www.instagram.com/','@');
return a;
}


if (loadBtn && consent && embed) {
loadBtn.addEventListener('click', () => {
consent.hidden = true;
embed.hidden = false;


if (WIDGET_URL) {
const iframe = document.createElement('iframe');
iframe.src = WIDGET_URL;
iframe.loading = 'lazy';
iframe.referrerPolicy = 'no-referrer-when-downgrade';
iframe.style.width = '100%';
iframe.style.height = '800px';
iframe.style.border = '0';
iframe.setAttribute('title', 'Instagram Vorschau');
embed.appendChild(iframe);
} else {
embed.appendChild(buildFallbackBadge("" + IG_URL));
}
});
}
</script>


<style>
.btn { display:inline-block; padding:.6rem 1rem; border-radius:.6rem; background:#66ccff; color:#00121a; text-decoration:none; font-weight:600; }
.btn:hover { filter:brightness(.95); }


.ig-consent { background:#11111de0; border-radius:1rem; padding:1rem; box-shadow:0 0 10px rgba(0,0,0,.4); }
.ig-box { display:flex; gap:1rem; align-items:center; justify-content:space-between; flex-wrap:wrap; }
.ig-embed { margin-top:1rem; }
.ig-badge { display:inline-block; padding:1rem 1.25rem; border:2px solid #444; border-radius:1rem; font-weight:700; text-decoration:none; }
</style>
</BaseLayout>