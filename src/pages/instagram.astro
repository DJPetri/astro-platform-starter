---
import BaseLayout from "../../layouts/BaseLayout.astro";

const IG_USER = "petrievents"; // <- anpassen, z.B. "petrievents"
const IG_URL = `https://www.instagram.com/${IG_USER}/`;
---

<BaseLayout title="Instagram | Petrievents">
<section class="hero">
<h1>Folge mir auf <span class="highlight">Instagram</span></h1>
<p class="subheading">Aktuelle Bilder & Reels von Events – ganz ohne Login ansehen.</p>


<!-- Primärer Profil-Link -->
<p style="margin-top:1rem">
<a class="btn" href={IG_URL} target="_blank" rel="noopener noreferrer">@{IG_USER} auf Instagram öffnen</a>
</p>
</section>

</BaseLayout>