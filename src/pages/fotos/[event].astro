---
export const prerender = false;

import events from "../../data/events.json";

import EventCard from "../../components/EventCard.astro";
import EventExpired from "../../components/EventExpired.astro";
import EventUploadComplete from "../../components/EventUploadComplete.astro";

const uploadSuccess =
  Astro.url.searchParams.get("success") === "1";
const event = Astro.params.event;

if (!event) {
  return Astro.redirect("/404");
}

const eventData = events[event as keyof typeof events];

if (!eventData) {
  return Astro.redirect("/404");
}

const today = new Date();

const uploadUntil = new Date(
  Number(eventData.uploadUntil.slice(0, 4)),
  Number(eventData.uploadUntil.slice(4, 6)) - 1,
  Number(eventData.uploadUntil.slice(6, 8)),
  23,
  59,
  59
);

const uploadExpired = today > uploadUntil;
---

{
  uploadExpired
    ? <EventExpired eventData={eventData} />
    : uploadSuccess
      ? <EventUploadComplete eventData={eventData} />
      : <EventCard eventData={eventData} />
}
