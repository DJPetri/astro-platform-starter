---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Kontakt | Petrievents">
  <section class="features">
    <h2>Kontakt</h2>

    <form id="kontakt-form">
      <!-- Honeypot-Feld gegen Spam -->
      <input
        type="text"
        name="_gotcha"
        style="display: none;"
        autocomplete="off"
      />

      <label for="name">Name:</label>
      <input
        type="text"
        id="name"
        name="name"
        required
      />

      <label for="email">E-Mail:</label>
      <input
        type="email"
        id="email"
        name="email"
        required
      />

      <label for="nachricht">Nachricht:</label>
      <textarea
        id="nachricht"
        name="message"
        rows="5"
        required
      ></textarea>

      <button type="submit" id="submit-button">
        Absenden
      </button>

      <!-- Fehlermeldung -->
      <p id="form-error" class="form-error" style="display: none;">
        ❌ Die Nachricht konnte nicht gesendet werden.
        Bitte überprüfen Sie Ihre Eingaben und versuchen Sie es erneut.
      </p>
    </form>
  </section>

  <script>
    const form = document.getElementById("kontakt-form") as HTMLFormElement;
    const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
    const errorMessage = document.getElementById("form-error") as HTMLElement;

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      errorMessage.style.display = "none";

      submitButton.disabled = true;
      submitButton.textContent = "Wird gesendet...";

      const formData = new FormData(form);

      try {
        const response = await fetch(
          "https://formspree.io/f/xzeboyva",
          {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json"
            }
          }
        );

        if (response.ok) {
          // Nachricht wurde erfolgreich an Formspree übermittelt
          window.location.href = "/danke";
        } else {
          // Formspree hat einen Fehler zurückgegeben
          throw new Error("Formspree Fehler");
        }

      } catch (error) {
        console.error("Fehler beim Senden des Formulars:", error);

        // Nutzer informieren
        errorMessage.style.display = "block";

        // Button wieder aktivieren
        submitButton.disabled = false;
        submitButton.textContent = "Erneut versuchen";
      }
    });
  </script>

  <style>
    .form-error {
      margin-top: 1rem;
      padding: 1rem;
      border-radius: 0.75rem;
      background: rgba(180, 0, 0, 0.15);
      border: 1px solid rgba(255, 80, 80, 0.5);
      color: #ff6b6b;
      font-weight: 600;
    }
  </style>
</BaseLayout>