---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Leistungen | Petrievents">

  <!-- Intro -->
  <section class="features">
    <h2>DJ-Pakete & Leistungen</h2>
    <p>
      Hier findest du meine individuell abgestimmten DJ-Pakete für Hochzeiten, Geburtstage und Firmenfeiern.  
      Alle Auf- und Abbauten sind inklusive – und dank Open-End-Garantie feierst du, solange du willst.
    </p>
  </section>

  <!-- Paket 1 -->
  <section class="features paket">
    <div class="paket-content left">
      <div class="paket-text">
        <h2>🎵 Paket 1 – Musik & Grundbeleuchtung</h2>
        <ul>
          <li>DJ-Tisch & Pult im einheitlichen Design</li>
          <li>2 × HK Audio Topteile für klaren, druckvollen Sound</li>
          <li>4 Uplights für dezente Raum- oder Wandbeleuchtung</li>
          <li>1 Effektlicht für sanfte Bewegung auf der Tanzfläche</li>
          <li>1 Funkmikrofon (ideal für Reden oder Spiele)</li>
          <li>Kompletter Auf- & Abbau der Technik</li>
          <li>Open-End – keine Zusatzkosten bei längerer Party</li>
        </ul>
        <p><strong>Empfohlen für:</strong> Geburtstage, kleinere Hochzeiten, Sektempfänge und Vereinsfeiern.</p>
        <p><em>Kompakt. Zuverlässig. Feierbereit bis zum letzten Song.</em></p>
      </div>
      <img src="/bilder/paket1.jpg" alt="DJ-Paket 1 – Musik & Grundbeleuchtung" class="paket-img" />
    </div>
  </section>

  <!-- Paket 2 -->
  <section class="features paket">
    <div class="paket-content right">
      <img src="/bilder/paket2.jpg" alt="DJ-Paket 2 – Musik & erweiterte Lichtshow" class="paket-img" />
      <div class="paket-text">
        <h2>🎆 Paket 2 – Musik & erweiterte Lichtshow</h2>
        <ul>
          <li>Alle Leistungen aus Paket 1</li>
          <li>2 × 4 bewegte Lichteffekte (Moving Heads / Scanner)</li>
          <li>Musikgesteuerte Lichtsteuerung, live angepasst an Tempo & Stimmung</li>
          <li>Hazer (feiner Nebel) für sichtbare Lichtstrahlen & Atmosphäre</li>
          <li>Kompletter Auf- & Abbau der Technik</li>
          <li>Open-End – keine Zusatzkosten bei längerer Party</li>
        </ul>
        <p><strong>Empfohlen für:</strong> Hochzeiten, Jubiläen, Firmenfeiern und größere Geburtstage.</p>
        <p><em>Maximales Licht. Maximaler Sound. Maximale Stimmung.</em></p>
      </div>
    </div>
  </section>

  <!-- Individuelle Leistungen -->
  <section class="features">
    <h2>🔧 Individuelle Leistungen</h2>

    <h3>🎚️ Persönlich zugeschnittene Audiotechnik</h3>
    <p>
      Ich stimme die gesamte Tonanlage – Leistung, Größe und Aufbau – individuell auf Location, Gästezahl und Musikrichtung ab.  
      Vom kleinen Weingut bis zum Open-Air-Festival – ich liefere den passenden Sound.
    </p>

    <h3>💡 Persönlich zugeschnittenes Lichtpaket</h3>
    <p>
      Licht macht Stimmung. Ich berate euch individuell und gestalte das Lichtkonzept nach euren Vorstellungen –  
      von elegantem Ambientelicht bis zur kompletten Show-Inszenierung.
    </p>
  </section>

  <!-- Zubuchoptionen -->
  <section class="features">
    <h2>☁️ Optionale Zubuchungen</h2>

    <div class="options-grid">
      <div class="option-card">
        <h3>Weitere Funkmikrofone</h3>
        <img src="/bilder/funkmikro.jpg" alt="Funkmikrofone" />
      </div>

      <div class="option-card">
        <h3>Bodennebelmaschine</h3>
        <img src="/bilder/bodennebel.jpg" alt="Bodennebelmaschine" />
      </div>

      <div class="option-card">
        <h3>Fotobox mit Requisiten</h3>
        <img src="/bilder/fotobox.jpg" alt="Fotobox" />
      </div>

      <div class="option-card">
        <h3>Zusätzliche Lautsprecher</h3>
        <img src="/bilder/lautsprecher.jpg" alt="Zusätzliche Lautsprecher" />
      </div>

      <div class="option-card">
        <h3>Ambiente-Paket</h3>
        <img src="/bilder/ambiente.jpg" alt="Ambiente-Paket" />
      </div>
    </div>
  </section>
</BaseLayout>
