---
import FileUploader from "./FileUploader.astro";
import { getEventTheme } from "../lib/eventTheme.js";

const { eventData } = Astro.props;
const eventTheme = getEventTheme(eventData);

const formattedDate =
  eventData.date.length === 8
    ? `${parseInt(eventData.date.slice(6, 8), 10)}/${parseInt(eventData.date.slice(4, 6), 10)}/${eventData.date.slice(0, 4)}`
    : eventData.date;
---

<html lang="de">
<head>

  <meta charset="utf-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>{eventData.title} | Petri Events</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #ebe6de;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      font-family: Arial, Helvetica, sans-serif;
    }

    .card {
      width: 100%;
      max-width: 430px;
      background: #f8f4ee;
      border-radius: 32px;
      padding: 40px 30px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      overflow: hidden;
    }

    .hero-image {
    width: calc(100% + 60px);
    height: 240px;
    object-fit: cover;
    object-position: center;
    margin-left: -30px;
    margin-right: -30px;
    margin-top: -40px;
    margin-bottom: 30px;
    border-radius: 32px 32px 0 0;
    }

    .subtitle {
      font-size: 0.85rem;
      letter-spacing: 8px;
      color: #7d746f;
      margin-bottom: 25px;
    }

    h1 {
      font-family: "Abhaya Libre", serif;
      font-size: 4rem;
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: 2px;
      color: #111;
      margin-bottom: 20px;
      overflow-wrap: anywhere;
    }

    .date {
      font-family: "Abhaya Libre", serif;
      font-size: 1.6rem;
      font-weight: 500;
      letter-spacing: 2px;
      color: #8b817b;
      margin-bottom: 40px;
    }

    .text {
      color: #555;
      line-height: 1.8;
      margin-bottom: 40px;
    }

    .footer {
      margin-top: 25px;
      font-size: 0.8rem;
      color: #888;
      line-height: 1.5;
    }

    @media (max-width: 480px) {
      body {
        align-items: flex-start;
        padding: 12px;
      }

      .card {
        border-radius: 24px;
        padding: 30px 20px;
      }

      .hero-image {
        width: calc(100% + 40px);
        height: 200px;
        margin-left: -20px;
        margin-right: -20px;
        margin-top: -30px;
        border-radius: 24px 24px 0 0;
      }

      h1 {
        font-size: clamp(2.3rem, 13vw, 3rem);
      }

      .date {
        font-size: 1.3rem;
      }

      .subtitle {
        letter-spacing: 5px;
      }
    }

  </style>

</head>

<body>

  <div class="card">

    <img
    src={eventTheme.heroImage}
    alt={eventTheme.heroAlt}
    class="hero-image"
    />

    <h1>
      {eventData.title}
    </h1>

    <div class="date">
      {formattedDate}
    </div>

    <div class="text">
      {eventTheme.shareText}
    </div>

<FileUploader eventData={eventData} />

    <div class="footer">
      {eventTheme.privacyText}
    </div>

  </div>

</body>
</html>
