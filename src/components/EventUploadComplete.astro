---
---

<html lang="de">
<head>

  <meta charset="utf-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>Veranstaltung beendet | Petri Events</title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .hero-image {
    width: calc(100% + 60px);
    height: 240px;
    object-fit: cover;
    object-position: center;
    margin-left: -30px;
    margin-right: -30px;
    margin-top: -40px;
    margin-bottom: 30px;
    border-radius: 32px 32px 0 0;
    }

    body {
      background: #ebe6de;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      font-family: Arial, Helvetica, sans-serif;
    }

    .card {
      width: 100%;
      max-width: 430px;
      background: #f8f4ee;
      border-radius: 32px;
      padding: 40px 30px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      overflow: hidden;
    }

    .logo {
      width: 220px;
      max-width: 100%;
      margin-bottom: 35px;
    }

    .subtitle {
      font-size: 0.85rem;
      letter-spacing: 8px;
      color: #7d746f;
      margin-bottom: 25px;
    }

    h1 {
      font-family: "Abhaya Libre", serif;
      font-size: 3rem;
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: 2px;
      color: #111;
      margin-bottom: 25px;
      overflow-wrap: anywhere;
    }

    .text {
      color: #555;
      line-height: 1.8;
      margin-bottom: 25px;
    }

    .instagram {
      display: block;
      width: 100%;
      margin-top: 15px;
      padding: 18px;
      border-radius: 999px;
      text-decoration: none;
      color: white;
      font-weight: bold;
      font-size: 1rem;
      letter-spacing: 1px;
      background: linear-gradient(
        45deg,
        #833ab4,
        #c13584,
        #e1306c,
        #fd1d1d,
        #fcb045
      );

      transition: all 0.2s ease;
    }

    .instagram:hover {
      transform: translateY(-2px);
    }

    .footer {
      margin-top: 30px;
      font-size: 0.8rem;
      color: #888;
      line-height: 1.6;
    }

    @media (max-width: 480px) {
      body {
        align-items: flex-start;
        padding: 12px;
      }

      .card {
        border-radius: 24px;
        padding: 30px 20px;
      }

      .hero-image {
        width: calc(100% + 40px);
        height: 200px;
        margin-left: -20px;
        margin-right: -20px;
        margin-top: -30px;
        border-radius: 24px 24px 0 0;
      }

      h1 {
        font-size: clamp(2rem, 11vw, 2.3rem);
      }

      .subtitle {
        letter-spacing: 5px;
      }

    }
      .upload-again {
        display: block;
        width: 100%;
        margin-top: 15px;
        padding: 18px;
        border-radius: 999px;
        text-decoration: none;
        text-align: center;
        background: #d9cdbd;
        color: #222;
        font-weight: bold;
        font-size: 1rem;
        letter-spacing: 1px;
        transition: all 0.2s ease;
      }

      .upload-again:hover {
        background: #cfc0ad;
        transform: translateY(-2px);
      }

      .promo-text {
        color: #555;
        text-align: center;
        line-height: 1.8;
        margin-top: 25px;
        margin-bottom: 25px;
}

      @media (max-width: 480px) {
        .upload-again,
        .instagram {
          padding: 14px 16px;
          font-size: 0.9rem;
          line-height: 1.25;
        }

        .upload-again:hover,
        .instagram:hover {
          transform: none;
        }
      }

  </style>

</head>

<body>

  <div class="card">

    <img
    src="/bilder/Weddingbackground.png"
    alt="Hochzeitslocation"
    class="hero-image"
    />

    <h1>
      Vielen Dank ❤️
    </h1>

    <div class="text">
      Der Upload hat funktioniert.
    </div>

    <div class="text">
      Vielen Dank an alle Gäste für die
      eingereichten Fotos und Videos.
    </div>

    <a
      class="upload-again"
      href="#"
      onclick="window.location.href = window.location.pathname"
    >
      📸 Weitere Bilder hochladen
    </a>
    <div class="promo-text">
      Lasst gerne ein Like da und folgt mir auf Instagram.
    </div>
    <a
      class="instagram"
      href="https://www.instagram.com/djdenydusk/"
      target="_blank"
      rel="noopener noreferrer"
    >
      📸 @DJ Christian Petri auf Instagram
    </a>

    <div class="footer">
      DJ • Hochzeiten • Eventtechnik
    </div>

  </div>

</body>
</html>
