---
const { eventData } = Astro.props;
const clientEventData = {
  title: eventData.title,
  date: eventData.date,
  storageFolder: eventData.storageFolder,
};
---

<style>
  .upload-button {
    width: 100%;
    height: 68px;
    border: none;
    border-radius: 999px;
    background: #000;
    color: white;
    font-size: 1rem;
    font-weight: bold;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
  }
  .upload-button:hover {
    transform: translateY(-2px);
  }
  .submit-button {
    width: 100%;
    height: 68px;
    margin-top: 20px;
    border: none;
    border-radius: 999px;
    background: #d9cdbd;
    color: #222;
    font-size: 1rem;
    font-weight: bold;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .submit-button:hover {
    background: #cfc0ad;
    transform: translateY(-2px);
  }
  .file-list {
    margin-top: 20px;
    text-align: left;
  }
  .file-entry {
    margin-bottom: 10px;
    font-size: 15px;
    color: #333;
    word-break: break-word;
  }
</style>
<div>
  <button
    class="upload-button"
    onclick="document.getElementById('fileInput')?.click()"
  >
    📸 FOTOS & VIDEOS HOCHLADEN
  </button>
  <input
    type="file"
    id="fileInput"
    multiple
    accept="image/*,video/*"
    style="display:none"
  />
  <div id="fileList" class="file-list"></div>
  <button id="submitButton" class="submit-button" style="display:none;">
    🚀 DATEIEN SENDEN
  </button>
</div>
<div
  id="progressContainer"
  style="display:none; margin-top:20px; text-align:center;"
>
  <progress
    id="progressBar"
    value="0"
    max="100"
    style="width:100%; height:24px;"></progress>

  <div id="progressText" style="margin-top:10px;">0%</div>
</div>
<script define:vars={{ clientEventData }}>
  document.addEventListener("DOMContentLoaded", () => {
    const fileInput = document.getElementById("fileInput");
    const fileList = document.getElementById("fileList");
    const submitButton = document.getElementById("submitButton");
    const progressContainer =
      document.getElementById("progressContainer");
    const progressBar =
      document.getElementById("progressBar");
    const progressText =
      document.getElementById("progressText");

    if (
      !(fileInput instanceof HTMLInputElement) ||
      !(fileList instanceof HTMLDivElement) ||
      !(submitButton instanceof HTMLButtonElement)||
      !(progressContainer instanceof HTMLDivElement) ||
      !(progressBar instanceof HTMLProgressElement) ||
      !(progressText instanceof HTMLDivElement)
    ) {
      return;
    }

    fileInput.addEventListener("change", () => {
      fileList.innerHTML = "";

      let validFiles = 0;

      const files = Array.from(fileInput.files || []);

      files.forEach((file) => {
        const sizeMB = file.size / 1024 / 1024;

        const isImage = file.type.startsWith("image/");
        const isVideo = file.type.startsWith("video/");

        let valid = true;
        let error = "";

        // Nur Bilder und Videos

        if (!isImage && !isVideo) {
          valid = false;
          error = "Nur Bilder und Videos erlaubt";
        }

        // Bilder maximal 15 MB

        if (isImage && sizeMB > 15) {
          valid = false;
          error = "Bild größer als 15 MB";
        }

        // Videos maximal 200 MB

        if (isVideo && sizeMB > 200) {
          valid = false;
          error = "Video größer als 200 MB";
        }

        if (valid) {
          validFiles++;
        }

        const row = document.createElement("div");

        row.className = "file-entry";

        row.innerHTML = valid
          ? `✅ ${file.name} (${sizeMB.toFixed(1)} MB)`
          : `❌ ${file.name} (${error})`;

        fileList.appendChild(row);
      });

      submitButton.style.display = validFiles > 0 ? "block" : "none";
    });

    submitButton.addEventListener("click", async () => {
      const files = Array.from(fileInput.files || []);

      if (files.length === 0) {
        return;
      }

      submitButton.disabled = true;
      submitButton.innerText = "⏳ UPLOAD LÄUFT...";
      progressContainer.style.display = "block";
      progressBar.value = 0;
      progressText.innerText = "Upload wird vorbereitet...";
      try {
      for (const [index, file] of files.entries()) {

        submitButton.innerText =
          `📤 ${index + 1}/${files.length} DATEIEN`;

        progressBar.value = 0;

        progressText.innerText =
          `Datei ${index + 1} von ${files.length}

      📤 ${file.name}

      Warte auf Uploadstart...`;

        const response = await fetch(
            "/.netlify/functions/create-upload-url",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                storageFolder: clientEventData.storageFolder,
                eventDate: clientEventData.date,
                eventTitle: clientEventData.title,
                fileName: file.name,
                contentType: file.type,
              }),
            },
          );

          if (!response.ok) {
            throw new Error("Upload URL konnte nicht erstellt werden");
          }

          const { uploadUrl } = await response.json();

          await new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();

            xhr.upload.addEventListener("progress", (event) => {
              if (!event.lengthComputable) {
                return;
              }

              const percent = Math.round((event.loaded / event.total) * 100);

              progressBar.value = percent;

              const loadedMB = (event.loaded / 1024 / 1024).toFixed(1);
              const totalMB = (event.total / 1024 / 1024).toFixed(1);

              progressText.innerText =
                `Datei ${index + 1} von ${files.length}

              📤 ${file.name}

              ${loadedMB} MB von ${totalMB} MB

              (${percent}%)`;
            });

            xhr.onload = () => {
              if (xhr.status >= 200 && xhr.status < 300) {
                resolve();
              } else {
                reject(new Error("Datei konnte nicht hochgeladen werden"));
              }
            };

            xhr.onerror = () => {
              reject(new Error("Datei konnte nicht hochgeladen werden"));
            };

            xhr.open("PUT", uploadUrl);

            xhr.setRequestHeader("Content-Type", file.type);

            xhr.send(file);
          });
        }
        progressBar.value = 100;

        progressText.innerText =
          `✅ Alle ${files.length} Dateien erfolgreich hochgeladen`;

        submitButton.innerText =
          "✅ UPLOAD ERFOLGREICH";

        setTimeout(() => {
          window.location.href = window.location.pathname + "?success=1";
        }, 1000);
      } catch (error) {
        console.error(error);

        alert("Beim Upload ist ein Fehler aufgetreten.");

        submitButton.disabled = false;
        submitButton.innerText = "🚀 DATEIEN SENDEN";
      }
    });
  });
</script>
