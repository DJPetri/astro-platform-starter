---
const { eventData } = Astro.props;
const clientEventData = {
  title: eventData.title,
  date: eventData.date,
  storageFolder: eventData.storageFolder
};
---

<script define:vars={{ clientEventData }}>

document.addEventListener("DOMContentLoaded", () => {

  const fileInput = document.getElementById("fileInput");
  const fileList = document.getElementById("fileList");
  const submitButton = document.getElementById("submitButton");
  
if (
  !(fileInput instanceof HTMLInputElement) ||
  !(fileList instanceof HTMLDivElement) ||
  !(submitButton instanceof HTMLButtonElement)
) {
  return;
}

  if (!fileInput || !fileList || !submitButton) {
    return;
  }

  fileInput.addEventListener("change", () => {

    fileList.innerHTML = "";

    let validFiles = 0;

    const files = Array.from(fileInput.files || []);

    files.forEach((file) => {

      const sizeMB = file.size / 1024 / 1024;

      const isImage = file.type.startsWith("image/");
      const isVideo = file.type.startsWith("video/");

      let valid = true;
      let error = "";

      // Nur Bilder und Videos

      if (!isImage && !isVideo) {
        valid = false;
        error = "Nur Bilder und Videos erlaubt";
      }

      // Bilder maximal 15 MB

      if (isImage && sizeMB > 15) {
        valid = false;
        error = "Bild größer als 15 MB";
      }

      // Videos maximal 200 MB

      if (isVideo && sizeMB > 200) {
        valid = false;
        error = "Video größer als 200 MB";
      }

      if (valid) {
        validFiles++;
      }

      const row = document.createElement("div");

      row.className = "file-entry";

      row.innerHTML = valid
        ? `✅ ${file.name} (${sizeMB.toFixed(1)} MB)`
        : `❌ ${file.name} (${error})`;

      fileList.appendChild(row);

    });

    submitButton.style.display =
      validFiles > 0
        ? "block"
        : "none";

  });

  submitButton.addEventListener("click", async () => {

    const files = Array.from(fileInput.files || []);

    if (files.length === 0) {
      return;
    }

    submitButton.disabled = true;
    submitButton.innerText = "⏳ UPLOAD LÄUFT...";

    try {

      for (const file of files) {

        const response = await fetch(
          "/.netlify/functions/create-upload-url",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
            storageFolder: clientEventData.storageFolder,
            eventDate: clientEventData.date,
            eventTitle: clientEventData.title,
            fileName: file.name,
            contentType: file.type
          })
          }
        );

        if (!response.ok) {
          throw new Error(
            "Upload URL konnte nicht erstellt werden"
          );
        }

        const { uploadUrl } = await response.json();

        const uploadResponse = await fetch(
          uploadUrl,
          {
            method: "PUT",
            headers: {
              "Content-Type": file.type
            },
            body: file
          }
        );

        if (!uploadResponse.ok) {
          throw new Error(
            "Datei konnte nicht hochgeladen werden"
          );
        }

      }

      submitButton.innerText =
        "✅ UPLOAD ERFOLGREICH";

      setTimeout(() => {
        window.location.href = "/danke";
      }, 1000);

    } catch (error) {

      console.error(error);

      alert(
        "Beim Upload ist ein Fehler aufgetreten."
      );

      submitButton.disabled = false;
      submitButton.innerText =
        "🚀 DATEIEN SENDEN";

    }

  });

});

</script>